{
  "name": "@magnit-ce/task-board",
  "version": "0.0.4",
  "description": "A custom html element that provides layout and management for custom task-list elements.",
  "main": "dist/task-board.umd.js",
  "module": "dist/task-board.js",
  "types": "dist/task-board.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build-tests": "vite build --config vite.config.tests.ts",
    "changeset": "npx @changesets/cli",
    "release": "npm run build && npx @changesets/cli publish"
  },
  "keywords": [
    "custom",
    "element",
    "html",
    "browser",
    "task",
    "task management",
    "board",
    "layout"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@magnit-ce/test-runner": "^0.0.8",
    "@rollup/plugin-terser": "^1.0.0",
    "changesets": "^1.0.2",
    "glob": "^13.0.0",
    "typescript": "^5.5.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "author": "catapart",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/catapart/magnitce-task-board"
  },
  "dependencies": {
    "@magnit-ce/task-card": "^0.0.25",
    "@magnit-ce/task-list": "^0.0.17"
  }
}
